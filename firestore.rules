rules_version = '2';

// Rules for "המכולת שלנו".
// They only allow the app's own collections, and every write must have the exact shape the app writes:
// known fields only, correct types, sane sizes. Anything else (junk collections, script in a color
// field, a text "amount", a 10-million-shekel expense) is rejected by the server.
//
// Note: this validates WHAT is written, not WHO writes it. The page's password is checked in the
// browser only, so anyone who has the project id can still send well-formed writes.
// Locking it to the four of you needs sign-in (Firebase Auth) — see README.

service cloud.firestore {
  match /databases/{database}/documents {

    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max); }
    function amount(v) { return v is int && v > 0 && v <= 10000000; }          // agorot, up to ₪100,000
    function date(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function ms(v) { return v is int || v is float; }                          // Date.now()

    // ── Shopping list ───────────────────────────────────────────
    match /groceries/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name','qty','bought','cat','addedBy','createdAt'])
        && str(request.resource.data.name, 80)
        && (!('qty' in request.resource.data) || (request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty <= 99))
        && (!('bought' in request.resource.data) || request.resource.data.bought is bool)
        && optStr(request.resource.data, 'cat', 20)
        && optStr(request.resource.data, 'addedBy', 64)
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == null
            || request.resource.data.createdAt is timestamp || ms(request.resource.data.createdAt));
    }

    // ── Roommates ───────────────────────────────────────────────
    match /members/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name','color','createdAt'])
        && str(request.resource.data.name, 30)
        && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && ms(request.resource.data.createdAt);
    }

    // ── Expenses ────────────────────────────────────────────────
    match /expenses/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['title','amount','paidBy','splitAmong','custom','date','category','createdAt'])
        && str(request.resource.data.title, 200)
        && amount(request.resource.data.amount)
        && str(request.resource.data.paidBy, 64)
        && request.resource.data.splitAmong is list && request.resource.data.splitAmong.size() >= 1 && request.resource.data.splitAmong.size() <= 20
        && (!('custom' in request.resource.data) || request.resource.data.custom == null
            || (request.resource.data.custom is map && request.resource.data.custom.size() <= 20))
        && date(request.resource.data.date)
        && request.resource.data.category in ['super','home','bills','food','apt','other']
        && ms(request.resource.data.createdAt);
    }

    // ── Pay-backs between roommates ─────────────────────────────
    match /settlements/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['from','to','amount','date','createdAt'])
        && str(request.resource.data.from, 64)
        && str(request.resource.data.to, 64)
        && request.resource.data.from != request.resource.data.to
        && amount(request.resource.data.amount)
        && date(request.resource.data.date)
        && ms(request.resource.data.createdAt);
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
